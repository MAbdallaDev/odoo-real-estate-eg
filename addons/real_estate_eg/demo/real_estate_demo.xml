<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!--
        S10.1: Nile Heights Developments (docs/business-requirements.md, Chapter 6).
        Every name, number and person is invented. Tests never use this file:
        `make test` runs without demo data, and the test suite builds its own records.
        Contracts, payments and cheques are created by demo/real_estate_demo.py
        (called at the end of this file).
    -->

    <!-- The company. Country Egypt, so the chart template gives it EGP. -->
    <record id="base.EGP" model="res.currency">
        <field name="active" eval="True" />
    </record>
    <record id="demo_company_nile_heights" model="res.company">
        <field name="name">Nile Heights Developments</field>
        <field name="country_id" ref="base.eg" />
        <field name="currency_id" ref="base.EGP" />
        <field name="city">Cairo</field>
        <field name="email">info@nileheights.example</field>
        <!-- §6.4 collection and cancellation policy -->
        <field name="re_grace_days">7</field>
        <field name="re_late_fee_rate">1</field>
        <field name="re_late_fee_cap">10</field>
        <field name="re_at_risk_days">60</field>
        <field name="re_retention_percent">15</field>
        <field name="re_invoice_lead_days">0</field>
    </record>
    <!-- The administrator may open the demo company too. -->
    <record id="base.user_admin" model="res.users">
        <field
      name="company_ids"
      eval="[Command.link(ref('demo_company_nile_heights'))]"
    />
    </record>

