<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.real_estate_eg</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
          data-string="Real Estate"
          string="Real Estate"
          name="real_estate_eg"
        >
                    <block title="Accounting" name="real_estate_accounting">
                        <!-- BR-43: down payment and installments are customer advances. -->
                        <setting
              string="Customer Advances"
              company_dependent="1"
              help="Liability account for down payment and installment invoices."
            >
                            <field name="re_advance_account_id" />
                        </setting>
                        <!-- BR-23: the maintenance deposit is held money, not revenue. -->
                        <setting
              string="Maintenance Deposits"
              company_dependent="1"
              help="Liability account for maintenance deposit invoices."
            >
                            <field name="re_maintenance_account_id" />
                        </setting>
                        <!-- BR-22: invoice each line N days before its due date. -->
                        <setting
              string="Invoice Lead Days"
              company_dependent="1"
              help="Invoice a schedule line this many days before it is due."
            >
                            <field name="re_invoice_lead_days" />
                        </setting>
                        <!-- BR-33: kept from paid down payment and installments on cancellation. -->
                        <setting
              string="Cancellation Retention"
              company_dependent="1"
              help="Percent of the paid down payment and installments kept when a confirmed contract is cancelled."
            >
                            <field name="re_retention_percent" />
                        </setting>
                    </block>
                    <!-- §6.4 collection policy: BR-26 - BR-28, BR-30, BR-31. -->
                    <block title="Collections" name="real_estate_collections">
                        <setting
              string="Late Fee Rate"
              company_dependent="1"
              help="Simple interest, percent per month (1/30 of it per day), on the amount unpaid each day."
            >
                            <field name="re_late_fee_rate" />
                        </setting>
                        <setting
              string="Late Fee Cap"
              company_dependent="1"
              help="A line's total late fee never exceeds this percent of its amount."
            >
                            <field name="re_late_fee_cap" />
                        </setting>
                        <setting
              string="Late Fees Account"
              company_dependent="1"
              help="Income account for billed late fees."
            >
                            <field name="re_late_fee_account_id" />
                        </setting>
                        <setting
              string="Grace Period"
              company_dependent="1"
              help="A line is overdue once it is unpaid this many days after its effective due date."
            >
                            <field name="re_grace_days" />
                        </setting>
                        <setting
              string="At Risk After"
              company_dependent="1"
              help="A contract with a line more than this many days past due is flagged at risk."
            >
                            <field name="re_at_risk_days" />
                        </setting>
                    </block>
                    <block title="Reservations" name="real_estate_reservations">
                        <!-- BR-53 (v1.1): how long a held reservation keeps its unit. -->
                        <setting
              string="Reservation Hold"
              company_dependent="1"
              help="Days a confirmed or reserved reservation keeps its unit before it expires."
            >
                            <field name="re_reservation_hold_days" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
