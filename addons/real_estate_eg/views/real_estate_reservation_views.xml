<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- US-14 (v1.1): reservations before the contract. -->
    <record id="real_estate_reservation_view_list" model="ir.ui.view">
        <field name="name">real.estate.reservation.list</field>
        <field name="model">real.estate.reservation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="partner_id" />
                <field name="unit_id" />
                <field name="project_id" optional="show" />
                <field name="user_id" widget="many2one_avatar_user" optional="show" />
                <field name="amount" optional="show" />
                <field name="date_expiry" optional="show" />
                <field name="currency_id" column_invisible="1" />
                <field name="company_id" groups="base.group_multi_company" />
                <field
          name="state"
          widget="badge"
          decoration-info="state == 'requested'"
          decoration-warning="state == 'agent_confirmed'"
          decoration-success="state in ('reserved', 'converted')"
          decoration-muted="state in ('rejected', 'expired')"
        />
            </list>
        </field>
    </record>

    <record id="real_estate_reservation_view_form" model="ir.ui.view">
        <field name="name">real.estate.reservation.form</field>
        <field name="model">real.estate.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- BR-48: each button asks for the next state; the model checks who and when. -->
                    <button
            name="action_agent_confirm"
            type="object"
            string="Confirm Request"
            class="oe_highlight"
            invisible="state != 'requested'"
          />
                    <button
            name="action_reserve"
            type="object"
            string="Reserve"
            class="oe_highlight"
            invisible="state != 'agent_confirmed'"
            groups="real_estate_eg.group_real_estate_manager"
          />
                    <button
            name="action_create_contract"
            type="object"
            string="Create Contract"
            class="oe_highlight"
            invisible="state != 'reserved'"
          />
                    <button
            name="action_reject"
            type="object"
            string="Reject"
            invisible="state not in ('requested', 'agent_confirmed', 'reserved')"
            confirm="Reject this reservation?"
          />
                    <field
            name="state"
            widget="statusbar"
            statusbar_visible="requested,agent_confirmed,reserved,converted"
          />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'requested'" />
                            <field
                name="unit_id"
                readonly="state != 'requested'"
                domain="[('state', '=', 'available')]"
              />
                            <field name="project_id" />
                            <field
                name="user_id"
                readonly="not user_is_manager or state not in ('requested', 'agent_confirmed', 'reserved')"
                widget="many2one_avatar_user"
              />
                        </group>
                        <group>
                            <field
                name="amount"
                readonly="state not in ('requested', 'agent_confirmed') or (state == 'agent_confirmed' and not user_is_manager)"
              />
                            <field name="amount_received" />
                            <field
                name="payment_id"
                readonly="state not in ('requested', 'agent_confirmed')"
                options="{'no_create': True}"
              />
                            <field
                name="date_expiry"
                readonly="not user_is_manager or state not in ('agent_confirmed', 'reserved')"
              />
                            <field name="contract_id" invisible="not contract_id" />
                            <field name="currency_id" invisible="1" />
                            <field name="user_is_manager" invisible="1" />
                            <field
                name="company_id"
                groups="base.group_multi_company"
              />
                        </group>
                    </group>
                    <field
            name="note"
            readonly="state != 'requested' and not user_is_manager"
            placeholder="Notes from the call with the customer"
          />
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="real_estate_reservation_view_search" model="ir.ui.view">
        <field name="name">real.estate.reservation.search</field>
        <field name="model">real.estate.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="partner_id" />
                <field name="unit_id" />
                <field name="project_id" />
                <field name="user_id" />
                <filter
          name="my"
          string="My Reservations"
          domain="[('user_id', '=', uid)]"
        />
                <filter
          name="unassigned"
          string="Unassigned"
          domain="[('user_id', '=', False)]"
        />
                <separator />
                <filter
          name="requested"
          string="Requests"
          domain="[('state', '=', 'requested')]"
        />
                <filter
          name="to_approve"
          string="To Approve"
          domain="[('state', '=', 'agent_confirmed')]"
        />
                <filter
          name="reserved"
          string="Reserved"
          domain="[('state', '=', 'reserved')]"
        />
                <filter
          name="open"
          string="Open"
          domain="[('state', 'in', ('requested', 'agent_confirmed', 'reserved'))]"
        />
                <group>
                    <filter
            name="group_project"
            string="Project"
            context="{'group_by': 'project_id'}"
          />
                    <filter
            name="group_state"
            string="Status"
            context="{'group_by': 'state'}"
          />
                </group>
            </search>
        </field>
    </record>

    <record id="real_estate_reservation_action" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">real.estate.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
