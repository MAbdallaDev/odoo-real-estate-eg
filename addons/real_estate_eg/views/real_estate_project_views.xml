<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="real_estate_project_view_list" model="ir.ui.view">
        <field name="name">real.estate.project.list</field>
        <field name="model">real.estate.project</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" />
                <field name="name" />
                <field name="location" />
                <field name="expected_delivery_date" />
                <field name="unit_count" string="Units" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="real_estate_project_view_form" model="ir.ui.view">
        <field name="name">real.estate.project.form</field>
        <field name="model">real.estate.project</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field
                name="name"
                placeholder="e.g. Horizon New Cairo"
              /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. HNC" />
                            <field name="location" />
                        </group>
                        <group>
                            <field name="expected_delivery_date" />
                            <field name="user_id" widget="many2one_avatar_user" />
                            <field name="reservation_amount" />
                            <field name="currency_id" invisible="1" />
                            <field
                name="company_id"
                groups="base.group_multi_company"
              />
                            <field name="active" invisible="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Units" name="units">
                            <field name="unit_ids" readonly="1">
                                <list>
                                    <field name="code" />
                                    <field name="unit_type" />
                                    <field name="area" />
                                    <field name="list_price" />
                                    <field name="state" widget="badge" />
                                    <field name="currency_id" column_invisible="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_project_view_search" model="ir.ui.view">
        <field name="name">real.estate.project.search</field>
        <field name="model">real.estate.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <filter
          name="inactive"
          string="Archived"
          domain="[('active', '=', False)]"
        />
            </search>
        </field>
    </record>

    <record id="real_estate_project_action" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">real.estate.project</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
