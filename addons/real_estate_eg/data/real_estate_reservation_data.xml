<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <!-- BR-47 (v1.1): reservation reference, e.g. RES/2027/00001. Restarts every year. -->
        <record id="seq_real_estate_reservation" model="ir.sequence">
            <field name="name">Real Estate Reservation</field>
            <field name="code">real.estate.reservation</field>
            <field name="prefix">RES/%(year)s/</field>
            <field name="padding">5</field>
            <field name="use_date_range" eval="True" />
            <field name="company_id" eval="False" />
        </record>
    </data>

    <!-- BR-53 (v1.1): its own nightly job, so the v1 nightly run is unchanged. -->
    <record id="ir_cron_real_estate_reservation_expire" model="ir.cron">
        <field name="name">Real Estate: expire reservations</field>
        <field name="model_id" ref="model_real_estate_reservation" />
        <field name="state">code</field>
        <field name="code">model._cron_expire()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field
      name="nextcall"
      eval="(DateTime.now().replace(hour=0, minute=30) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"
    />
    </record>
</odoo>
