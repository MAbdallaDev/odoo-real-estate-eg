<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- US-08 / BR-39: the unit import dialog (manager only, see the ACL). -->
    <record id="real_estate_unit_import_view_form" model="ir.ui.view">
        <field name="name">real.estate.unit.import.form</field>
        <field name="model">real.estate.unit.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="file" filename="filename" />
                    <field name="filename" invisible="1" />
                </group>
                <p>
                    A <b>.csv</b> (UTF-8, comma separated) or <b
          >.xlsx</b> file (first sheet).
                    Row 1 holds the column names:
                    <code
          >code, project_code, unit_type, area, list_price</code> (required),
                    <code>bedrooms, floor</code> (optional).
                </p>
                <ul class="text-muted">
                    <li>
                        A unit whose code already exists in this company is updated; a new
                        code creates a unit. Importing the same file again creates nothing.
                    </li>
                    <li>
                        If any row is wrong, nothing is imported, and every bad row is listed
                        with its row number and the reason.
                    </li>
                    <li>
                        Unit types: apartment, duplex, chalet, twin_house, office, retail.
                        Numbers without thousands separators.
                    </li>
                </ul>
                <p>
                    <a
            href="/real_estate_eg/static/sample/real_estate_units_sample.csv"
            download="real_estate_units_sample.csv"
          >Download a sample file</a>
                </p>
                <footer>
                    <button
            name="action_import"
            type="object"
            string="Import"
            class="btn-primary"
          />
                    <button string="Discard" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="real_estate_unit_import_action" model="ir.actions.act_window">
        <field name="name">Import Units</field>
        <field name="res_model">real.estate.unit.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
