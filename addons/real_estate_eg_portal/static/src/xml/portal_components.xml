<?xml version="1.0" encoding="UTF-8" ?>
<!-- US-16: the OWL templates of the customer pages (static/src/js). -->
<templates xml:space="preserve">
    <t t-name="real_estate_eg_portal.Pager">
        <nav
      t-if="pageCount > 1"
      class="d-flex justify-content-center align-items-center gap-3 my-3"
    >
            <button
        class="btn btn-sm btn-light"
        t-att-disabled="props.meta.page &lt;= 1"
        t-on-click="() => props.onChange(props.meta.page - 1)"
      >
                <i class="fa fa-chevron-left me-1" />Previous
            </button>
            <span class="small text-muted">
                Page <t t-esc="props.meta.page" /> of <t t-esc="pageCount" />
            </span>
            <button
        class="btn btn-sm btn-light"
        t-att-disabled="props.meta.page &gt;= pageCount"
        t-on-click="() => props.onChange(props.meta.page + 1)"
      >
                Next<i class="fa fa-chevron-right ms-1" />
            </button>
        </nav>
    </t>

    <t t-name="real_estate_eg_portal.Loading">
        <div t-if="state.loading" class="text-center text-muted my-5">
            <span class="spinner-border spinner-border-sm me-2" />Loading…
        </div>
        <div t-if="state.error" class="alert alert-danger" role="alert">
            <t t-esc="state.error" />
        </div>
    </t>

    <!-- AC-16.2 -->
    <t t-name="real_estate_eg_portal.UnitList">
        <RequestSent t-if="state.sent" reservation="state.sent" />

        <div t-if="state.banners.length" class="row g-3 mb-4">
            <div
        t-foreach="state.banners"
        t-as="project"
        t-key="project.id"
        class="col-md-6"
      >
                <button
          type="button"
          class="o_re_banner btn p-0 w-100 text-start"
          t-on-click="() => this.filterProject(project)"
        >
                    <img
            t-if="project.image_url"
            t-att-src="project.image_url"
            t-att-alt="project.name"
            loading="lazy"
          />
                    <span class="o_re_banner_text">
                        <strong t-esc="project.name" />
                        <span>
                            <t t-if="project.location"><t
                  t-esc="project.location"
                /> · </t>
                            <t t-esc="project.available_units" /> available units
                        </span>
                    </span>
                </button>
            </div>
        </div>

        <div class="row g-2 align-items-end mb-3">
            <div class="col-sm-4">
                <label class="form-label small text-muted mb-1" for="re_project">
                    Project
                </label>
                <select
          id="re_project"
          class="form-select"
          t-model="state.filters.project_id"
          t-on-change="onFilter"
        >
                    <option value="">All projects</option>
                    <option
            t-foreach="props.projects"
            t-as="project"
            t-key="project.id"
            t-att-value="project.id"
            t-esc="project.name"
          />
                </select>
            </div>
            <div class="col-sm-3">
                <label
          class="form-label small text-muted mb-1"
          for="re_type"
        >Type</label>
                <select
          id="re_type"
          class="form-select"
          t-model="state.filters.unit_type"
          t-on-change="onFilter"
        >
                    <option value="">All types</option>
                    <option
            t-foreach="props.unitTypes"
            t-as="type"
            t-key="type.value"
            t-att-value="type.value"
            t-esc="type.label"
          />
                </select>
            </div>
            <div class="col-sm-3">
                <label class="form-label small text-muted mb-1" for="re_bedrooms">
                    Bedrooms
                </label>
                <select
          id="re_bedrooms"
          class="form-select"
          t-model="state.filters.bedrooms"
          t-on-change="onFilter"
        >
                    <option value="">Any</option>
                    <option
            t-foreach="[1, 2, 3, 4, 5]"
            t-as="count"
            t-key="count"
            t-att-value="count"
            t-esc="count"
          />
                </select>
            </div>
            <div class="col-sm-2 text-sm-end small text-muted">
                <t t-esc="state.meta.total" /> units
            </div>
        </div>

        <t t-call="real_estate_eg_portal.Loading" />
        <p
      t-if="!state.loading and !state.error and !state.units.length"
      class="text-muted my-5 text-center"
    >
            No available unit matches these filters.
        </p>
        <div t-if="!state.loading" class="row g-3">
            <div
        t-foreach="state.units"
        t-as="unit"
        t-key="unit.id"
        class="col-md-6 col-lg-4"
      >
                <div class="card h-100 o_re_unit_card">
                    <a
            class="o_re_unit_photo"
            t-attf-href="/my/real-estate/units/{{ unit.id }}"
          >
                        <img
              t-if="unit.image_url"
              t-att-src="unit.image_url"
              t-att-alt="unit.code"
              loading="lazy"
            />
                        <span t-else="" class="o_re_no_photo fa fa-building-o" />
                        <span
              class="o_re_price_tag"
              t-esc="formatMoney(unit.list_price, unit.currency)"
            />
                    </a>
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start">
                            <h6 class="mb-0" t-esc="unit.code" />
                            <span class="badge text-bg-success">Available</span>
                        </div>
                        <div class="small text-muted mb-2" t-esc="unit.project.name" />
                        <div class="small mb-3">
                            <t t-esc="unitTypeLabel(unit.unit_type)" /> ·
                            <t t-esc="unit.bedrooms" /> bedrooms ·
                            <t t-esc="unit.area" /> m² · floor <t t-esc="unit.floor" />
                        </div>
                        <div class="d-flex gap-2 mt-auto">
                            <a
                class="btn btn-light btn-sm flex-fill"
                t-attf-href="/my/real-estate/units/{{ unit.id }}"
              >View details</a>
                            <button
                class="btn btn-primary btn-sm flex-fill"
                t-on-click="() => this.open(unit)"
              >
                                <i class="fa fa-bookmark-o me-1" />Request
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <Pager meta="state.meta" onChange.bind="onPage" />

        <ReserveForm
      t-if="state.selected"
      unit="state.selected"
      onSent.bind="onSent"
      onClose.bind="close"
    />
    </t>

    <!-- AC-16.2 / BR-57: after a request is sent. -->
    <t t-name="real_estate_eg_portal.RequestSent">
        <div class="alert alert-success d-flex gap-3 align-items-start" role="status">
            <i class="fa fa-check-circle fa-2x" />
            <div>
                <strong>Request <t t-esc="props.reservation.reference" /> sent.</strong>
                <div>
                    The sales agent of <t t-esc="props.reservation.project.name" /> will
                    call you to agree the terms. The unit is held for you once you pay
                    the reservation amount.
                </div>
                <a
          class="btn btn-sm btn-success mt-2"
          href="/my/real-estate/reservations"
        >
                    See my reservations
                </a>
            </div>
        </div>
    </t>

    <!-- US-17 / BR-63: one unit's page. -->
    <t t-name="real_estate_eg_portal.UnitDetail">
        <t t-call="real_estate_eg_portal.Loading" />
        <t t-set="unit" t-value="state.unit" />
        <t t-if="unit">
            <RequestSent t-if="state.sent" reservation="state.sent" />
            <div
        class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3"
      >
                <div>
                    <div class="small text-muted text-uppercase">
                        <t t-esc="unit.project.name" />
                        <t t-if="unit.project.location"> · <t
                t-esc="unit.project.location"
              /></t>
                    </div>
                    <h3 class="mb-0"><t t-esc="unitTypeLabel" /> <t
              t-esc="unit.code"
            /></h3>
                </div>
                <span
          t-if="unit.state === 'available'"
          class="badge text-bg-success fs-6"
        >Available</span>
            </div>
            <div class="row g-4">
                <div class="col-lg-8">
                    <div t-if="unit.images.length" class="o_re_gallery">
                        <img
              class="o_re_gallery_main rounded"
              t-att-src="unit.images[state.photo].url"
              t-att-alt="unit.images[state.photo].caption or unit.code"
            />
                        <div t-if="unit.images.length > 1" class="o_re_gallery_thumbs">
                            <button
                t-foreach="unit.images"
                t-as="image"
                t-key="image.id"
                type="button"
                t-attf-class="btn p-0 {{ image_index === state.photo ? 'active' : '' }}"
                t-att-aria-label="image.caption or ('Photo ' + (image_index + 1))"
                t-on-click="() => this.showPhoto(image_index)"
              >
                                <img
                  t-att-src="image.thumbnail_url"
                  alt=""
                  loading="lazy"
                />
                            </button>
                        </div>
                        <div
              t-if="unit.images[state.photo].caption"
              class="small text-muted mt-1"
              t-esc="unit.images[state.photo].caption"
            />
                    </div>

                    <div class="o_re_facts mt-4">
                        <div><span>Type</span><b t-esc="unitTypeLabel" /></div>
                        <div><span>Area</span><b><t t-esc="unit.area" /> m²</b></div>
                        <div><span>Bedrooms</span><b t-esc="unit.bedrooms" /></div>
                        <div><span>Floor</span><b t-esc="unit.floor" /></div>
                        <div>
                            <span>Price per m²</span>
                            <b t-esc="formatMoney(unit.price_per_sqm, unit.currency)" />
                        </div>
                        <div t-if="unit.project.expected_delivery_date">
                            <span>Expected delivery</span>
                            <b
                t-esc="formatDate(unit.project.expected_delivery_date)"
              />
                        </div>
                    </div>

                    <t t-if="unit.floor_plan_url">
                        <h5 class="mt-4">Floor plan</h5>
                        <a t-att-href="unit.floor_plan_url" target="_blank">
                            <img
                class="o_re_floor_plan rounded border w-100"
                t-att-src="unit.floor_plan_url"
                t-attf-alt="Floor plan of {{ unit.code }}"
                loading="lazy"
              />
                        </a>
                    </t>

                    <t t-if="unit.plans.length">
                        <h5 class="mt-4">Payment plans</h5>
                        <p class="small text-muted">
                            The plans this project is sold with, worked out on this unit's
                            price for a contract signed today. The agent agrees the final
                            plan with you.
                        </p>
                        <div class="d-flex flex-wrap gap-2 mb-2" role="tablist">
                            <button
                t-foreach="unit.plans"
                t-as="plan"
                t-key="plan.id"
                type="button"
                role="tab"
                t-att-aria-selected="plan_index === state.plan ? 'true' : 'false'"
                t-attf-class="btn btn-sm rounded-pill {{ plan_index === state.plan ? 'btn-primary' : 'btn-outline-secondary' }}"
                t-on-click="() => this.showPlan(plan_index)"
                t-esc="plan.name"
              />
                        </div>
                        <t t-set="plan" t-value="currentPlan" />
                        <div class="card">
                            <div class="card-body">
                                <div class="o_re_plan_grid">
                                    <div>
                                        <span>
                                            Down payment (<t
                        t-esc="plan.down_payment_percent"
                      />%)
                                        </span>
                                        <b
                      t-esc="formatMoney(plan.down_payment, unit.currency)"
                    />
                                    </div>
                                    <div t-if="plan.installment_count">
                                        <span>
                                            <t
                        t-esc="plan.installment_count"
                      /> installments,
                                            <t t-esc="frequencyLabel(plan.frequency)" />
                                        </span>
                                        <b
                      t-esc="formatMoney(plan.installment_amount, unit.currency)"
                    />
                                        <span
                      t-if="plan.last_installment_amount !== plan.installment_amount"
                    >
                                            last one
                                            <t
                        t-esc="formatMoney(plan.last_installment_amount)"
                      />
                                        </span>
                                    </div>
                                    <div t-if="plan.installment_count">
                                        <span>First installment</span>
                                        <b>
                                            <t
                        t-esc="plan.first_installment_months"
                      /> months
                                            after signing
                                        </b>
                                    </div>
                                    <div t-if="plan.maintenance">
                                        <span>
                                            Maintenance deposit
                                            (<t t-esc="plan.maintenance_percent" />%)
                                        </span>
                                        <b
                      t-esc="formatMoney(plan.maintenance, unit.currency)"
                    />
                                        <span
                      t-if="plan.maintenance_due === 'signing'"
                    >at signing</span>
                                        <span t-else="">at delivery</span>
                                    </div>
                                </div>
                                <div class="o_re_plan_bar" aria-hidden="true">
                                    <i
                    t-foreach="planShares(plan)"
                    t-as="share"
                    t-key="share[0]"
                    t-att-class="share[0]"
                    t-attf-style="width: {{ share[1] }}%"
                  />
                                </div>
                                <div class="o_re_plan_legend small text-muted">
                                    <span><i class="o_re_bar_down" />Down payment</span>
                                    <span><i
                      class="o_re_bar_installments"
                    />Installments</span>
                                    <span><i
                      class="o_re_bar_maintenance"
                    />Maintenance</span>
                                </div>
                                <p class="small text-muted mt-3 mb-0">
                                    Total <t
                    t-esc="formatMoney(plan.total, unit.currency)"
                  />,
                                    the maintenance deposit included.
                                </p>
                            </div>
                        </div>
                    </t>

                    <h5 class="mt-4">About the project</h5>
                    <div class="card overflow-hidden">
                        <div class="d-flex flex-wrap">
                            <img
                t-if="unit.project.image_url"
                class="o_re_project_cover"
                t-att-src="unit.project.image_url"
                t-att-alt="unit.project.name"
                loading="lazy"
              />
                            <div class="card-body o_re_project_text">
                                <h6 t-esc="unit.project.name" />
                                <p class="small text-muted mb-2">
                                    <t t-esc="unit.project.location" />
                                    <t t-if="unit.project.expected_delivery_date">
                                        · delivery expected
                                        <t
                      t-esc="formatDate(unit.project.expected_delivery_date)"
                    />
                                    </t>
                                </p>
                                <div
                  t-if="description"
                  class="small"
                  t-out="description"
                />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card o_re_buy_box">
                        <div class="card-body">
                            <div class="small text-muted">List price</div>
                            <div
                class="fs-3 fw-bold"
                t-esc="formatMoney(unit.list_price, unit.currency)"
              />
                            <div class="small text-muted mb-3">
                                <t
                  t-esc="formatMoney(unit.price_per_sqm, unit.currency)"
                /> / m²
                            </div>
                            <div
                t-if="lowestDownPayment !== null"
                class="d-flex justify-content-between border-top py-2 small"
              >
                                <span class="text-muted">Down payment from</span>
                                <b
                  t-esc="formatMoney(lowestDownPayment, unit.currency)"
                />
                            </div>
                            <div
                class="d-flex justify-content-between border-top py-2 small"
              >
                                <span class="text-muted">Reservation amount</span>
                                <b
                  t-esc="formatMoney(unit.project.reservation_amount, unit.currency)"
                />
                            </div>
                            <t t-if="unit.state === 'available'">
                                <button
                  class="btn btn-primary w-100 mt-3"
                  t-on-click="() => this.openRequest()"
                >
                                    <i
                    class="fa fa-bookmark-o me-1"
                  />Request reservation
                                </button>
                                <p class="small text-muted mt-2 mb-0">
                                    A request, not a booking: the project's sales agent
                                    calls you. The unit is held for you once you pay the
                                    reservation amount.
                                </p>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
            <ReserveForm
        t-if="state.requesting"
        unit="unit"
        onSent.bind="onSent"
        onClose.bind="closeRequest"
      />
        </t>
    </t>

    <!-- AC-16.2: the request dialog. -->
    <t t-name="real_estate_eg_portal.ReserveForm">
        <div
      class="modal d-block o_re_modal"
      tabindex="-1"
      role="dialog"
      aria-modal="true"
    >
            <div class="modal-dialog modal-dialog-centered">
                <form class="modal-content" t-on-submit.prevent="send">
                    <div class="modal-header">
                        <h5 class="modal-title">Request a reservation</h5>
                        <button
              type="button"
              class="btn-close"
              aria-label="Close"
              t-on-click="props.onClose"
            />
                    </div>
                    <div class="modal-body">
                        <div class="bg-light rounded p-2 mb-3 small">
                            <strong t-esc="props.unit.code" /> ·
                            <t t-esc="props.unit.project.name" /> ·
                            <t t-esc="props.unit.bedrooms" /> bedrooms ·
                            <t t-esc="props.unit.area" /> m² ·
                            <strong
                t-esc="formatMoney(props.unit.list_price, props.unit.currency)"
              />
                        </div>
                        <p class="small text-muted">
                            This is a request, not a booking. The project's sales agent
                            calls you to agree the terms; the unit is held for you once
                            you pay the reservation amount.
                        </p>
                        <div
              t-if="state.error"
              class="alert alert-danger py-2"
              role="alert"
            >
                            <t t-esc="state.error" />
                        </div>
                        <div class="mb-2">
                            <div class="form-label">Nationality</div>
                            <div class="form-check form-check-inline">
                                <input
                  id="re_nat_eg"
                  class="form-check-input"
                  type="radio"
                  value="egyptian"
                  t-model="state.nationality"
                />
                                <label class="form-check-label" for="re_nat_eg">
                                    Egyptian
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input
                  id="re_nat_foreign"
                  class="form-check-input"
                  type="radio"
                  value="foreign"
                  t-model="state.nationality"
                />
                                <label class="form-check-label" for="re_nat_foreign">
                                    Foreign
                                </label>
                            </div>
                        </div>
                        <div t-if="state.nationality === 'egyptian'" class="mb-2">
                            <label class="form-label" for="re_national_id">
                                National ID <span
                  class="small text-muted"
                >(14 digits)</span>
                            </label>
                            <input
                id="re_national_id"
                class="form-control"
                inputmode="numeric"
                maxlength="14"
                required="required"
                t-model="state.nationalId"
              />
                        </div>
                        <div t-else="" class="mb-2">
                            <label
                class="form-label"
                for="re_passport"
              >Passport number</label>
                            <input
                id="re_passport"
                class="form-control"
                maxlength="32"
                required="required"
                t-model="state.passport"
              />
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="re_note">
                                Note <span class="small text-muted">(optional)</span>
                            </label>
                            <textarea
                id="re_note"
                class="form-control"
                rows="2"
                maxlength="2000"
                t-model="state.note"
              />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button
              type="button"
              class="btn btn-light"
              t-on-click="props.onClose"
            >
                            Cancel
                        </button>
                        <button
              type="submit"
              class="btn btn-primary"
              t-att-disabled="state.sending"
            >
                            <i class="fa fa-paper-plane me-1" />Send request
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <div class="modal-backdrop show" />
    </t>

    <!-- AC-16.2: my reservations. -->
    <t t-name="real_estate_eg_portal.ReservationList">
        <div
      class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2"
    >
            <div class="small text-muted">
                Requested → Agent Confirmed → Reserved → Converted to a contract
            </div>
            <select
        class="form-select form-select-sm w-auto"
        aria-label="State"
        t-model="state.stateFilter"
        t-on-change="onFilter"
      >
                <option value="">All states</option>
                <option
          t-foreach="stateOptions"
          t-as="option"
          t-key="option.value"
          t-att-value="option.value"
          t-esc="option.label"
        />
            </select>
        </div>
        <t t-call="real_estate_eg_portal.Loading" />
        <p
      t-if="!state.loading and !state.error and !state.records.length"
      class="text-muted my-5 text-center"
    >
            No reservation yet. <a
        href="/my/real-estate/units"
      >Browse the available units</a>.
        </p>
        <div t-if="!state.loading and state.records.length" class="table-responsive">
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Unit</th>
                        <th>Project</th>
                        <th>Requested on</th>
                        <th>State</th>
                        <th>Held until</th>
                        <th class="text-end">Amount</th>
                        <th />
                    </tr>
                </thead>
                <tbody>
                    <tr
            t-foreach="state.records"
            t-as="reservation"
            t-key="reservation.id"
          >
                        <td t-esc="reservation.reference" />
                        <td t-esc="reservation.unit.name" />
                        <td t-esc="reservation.project.name" />
                        <td t-esc="formatDate(reservation.requested_on)" />
                        <td>
                            <span
                t-attf-class="badge {{ reservationState(reservation.state).badge }}"
                t-esc="reservationState(reservation.state).label"
              />
                        </td>
                        <td t-esc="formatDate(reservation.hold_until) or '—'" />
                        <td
              class="text-end"
              t-esc="formatMoney(reservation.amount, reservation.currency)"
            />
                        <td>
                            <a
                t-if="reservation.contract_id"
                t-attf-href="/my/real-estate/contracts/{{ reservation.contract_id }}"
              >
                                Contract <i class="fa fa-arrow-right" />
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <Pager meta="state.meta" onChange.bind="onPage" />
        <p class="small text-muted">
            You can have up to 5 open requests, one per unit. To cancel a request,
            call your sales agent.
        </p>
    </t>

    <!-- AC-16.2: my contracts / one contract. -->
    <t t-name="real_estate_eg_portal.ContractList">
        <t t-call="real_estate_eg_portal.Loading" />
        <p
      t-if="!state.loading and !state.error and !state.records.length"
      class="text-muted my-5 text-center"
    >
            You have no contract yet.
        </p>
        <div t-if="!state.loading and state.records.length" class="table-responsive">
            <table class="table table-sm table-striped align-middle">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Unit</th>
                        <th>Project</th>
                        <th>Date</th>
                        <th>State</th>
                        <th class="text-end">Price</th>
                        <th style="min-width: 10rem">Paid</th>
                        <th class="text-end">Outstanding</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="state.records" t-as="contract" t-key="contract.id">
                        <td>
                            <a
                t-attf-href="/my/real-estate/contracts/{{ contract.id }}"
                t-esc="contract.reference"
              />
                        </td>
                        <td t-esc="contract.unit.name" />
                        <td t-esc="contract.project.name" />
                        <td t-esc="formatDate(contract.date)" />
                        <td>
                            <span
                t-attf-class="badge {{ contractState(contract.state).badge }}"
                t-esc="contractState(contract.state).label"
              />
                        </td>
                        <td
              class="text-end"
              t-esc="formatMoney(contract.price, contract.currency)"
            />
                        <td>
                            <div class="progress" style="height: 8px">
                                <div
                  class="progress-bar bg-success"
                  t-attf-style="width: {{ paidPercent(contract) }}%"
                />
                            </div>
                            <div class="small text-muted">
                                <t
                  t-esc="formatMoney(contract.amount_paid, contract.currency)"
                />
                                (<t t-esc="paidPercent(contract)" />%)
                            </div>
                        </td>
                        <td
              class="text-end"
              t-esc="formatMoney(contract.amount_outstanding, contract.currency)"
            />
                    </tr>
                </tbody>
            </table>
        </div>
        <Pager meta="state.meta" onChange.bind="onPage" />
    </t>

    <!-- AC-16.2: my contracts / one contract. -->
    <t t-name="real_estate_eg_portal.ContractDetail">
        <t t-set="contract" t-value="state.contract" />
        <t t-if="contract">
            <div class="mb-3">
                <h4 class="mb-0">
                    <t t-esc="contract.reference" />
                    <span
            t-attf-class="badge fs-6 align-middle {{ contractState(contract.state).badge }}"
            t-esc="contractState(contract.state).label"
          />
                </h4>
                <div class="text-muted">
                    <t t-esc="contract.unit.name" /> · <t
            t-esc="contract.project.name"
          />
                    <t t-if="contract.date"> · <t
              t-esc="formatDate(contract.date)"
            /></t>
                </div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6 col-md-3">
                    <div class="border rounded p-2 h-100">
                        <div class="small text-muted">Price</div>
                        <div
              class="fs-5"
              t-esc="formatMoney(contract.price, contract.currency)"
            />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded p-2 h-100">
                        <div class="small text-muted">Paid</div>
                        <div
              class="fs-5 text-success"
              t-esc="formatMoney(contract.amount_paid, contract.currency)"
            />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="border rounded p-2 h-100">
                        <div class="small text-muted">Outstanding</div>
                        <div
              class="fs-5"
              t-esc="formatMoney(contract.amount_outstanding, contract.currency)"
            />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div
            t-attf-class="border rounded p-2 h-100 {{ state.overdueTotal ? 'border-danger' : '' }}"
          >
                        <div class="small text-muted">Overdue</div>
                        <div
              t-attf-class="fs-5 {{ state.overdueTotal ? 'text-danger' : '' }}"
              t-esc="formatMoney(state.overdueTotal, contract.currency)"
            />
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Installment schedule</h5>
                <div class="form-check form-switch mb-0">
                    <input
            id="re_overdue_only"
            class="form-check-input"
            type="checkbox"
            t-att-checked="state.overdueOnly"
            t-on-change="onToggleOverdue"
          />
                    <label
            class="form-check-label"
            for="re_overdue_only"
          >Overdue only</label>
                </div>
            </div>
        </t>
        <t t-call="real_estate_eg_portal.Loading" />
        <p
      t-if="contract and !state.loading and !state.error and !state.records.length"
      class="text-muted my-4 text-center"
    >
            No installment to show.
        </p>
        <div t-if="!state.loading and state.records.length" class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Line</th>
                        <th>Due date</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Paid</th>
                        <th class="text-end">Remaining</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr
            t-foreach="state.records"
            t-as="line"
            t-key="line.id"
            t-att-class="line.is_overdue ? 'table-danger' : ''"
          >
                        <td t-esc="line.label" />
                        <td t-esc="line.date_due ? formatDate(line.date_due) : '—'" />
                        <td class="text-end" t-esc="formatMoney(line.amount)" />
                        <td class="text-end" t-esc="formatMoney(line.amount_paid)" />
                        <td
              class="text-end"
              t-esc="formatMoney(line.amount_residual)"
            />
                        <td>
                            <span
                t-attf-class="badge {{ installmentState(line).badge }}"
                t-esc="installmentState(line).label"
              />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <Pager meta="state.meta" onChange.bind="onPage" />
        <p t-if="contract" class="small text-muted">
            Amounts in <t t-esc="contract.currency" />. Pay at the sales office or by
            bank transfer.
        </p>
    </t>
</templates>
