# CI test image: the pinned official Odoo 19 image plus an Arabic font.
#
# S08.1 / BR-38: the contract PDF prints Arabic beside English. wkhtmltopdf
# joins Arabic letters only with a font that has their joined forms, and the
# official image ships none, so the letters would print apart. fonts-noto-core
# holds Noto Naskh Arabic, the font the report's CSS names.
#
# odoo:19.0 (build 19.0-20261112; ships wkhtmltopdf 0.12.6.1 with patched Qt)
FROM odoo@sha256:03a47921f9eef2c225ded1167fe7828465d2b3177883f30d173bb1c3c792949b

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-core \
    && rm -rf /var/lib/apt/lists/*
USER odoo
