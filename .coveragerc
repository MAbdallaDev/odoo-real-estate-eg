# coverage.py settings for `make coverage` (local only; CI runs `make test-ci`).
[run]
source = addons/real_estate_eg
omit =
    # the tests themselves
    addons/real_estate_eg/tests/*
    # demo data loader: run by `make demo`, never by the tests
    addons/real_estate_eg/demo/*
    # read by Odoo as data, never imported
    addons/real_estate_eg/__manifest__.py

[report]
# The same list again: [run] omit only stops measuring, and an unimported
# file inside "source" would still be reported as 0%.
omit =
    addons/real_estate_eg/tests/*
    addons/real_estate_eg/demo/*
    addons/real_estate_eg/__manifest__.py
skip_empty = true
show_missing = false
