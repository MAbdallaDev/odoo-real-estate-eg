; Local Odoo configuration template.
; Copy it to odoo.conf (gitignored) and edit there; `make setup` does the copy.
; Paths are relative to the current directory: run Odoo from the repo root (the Makefile does).

[options]
; Odoo core addons first, then this repo's addons.
addons_path = odoo-src/odoo/addons,addons

; PostgreSQL: local Unix socket, dedicated non-superuser role with CREATEDB.
; The password is read from ~/.pgpass (mode 600), never from this file.
; db_host / db_port / db_password are left out on purpose: in Odoo 19 a value of
; False for a non-boolean option logs a warning and is skipped.
db_user = odoo19_real_estate

; Master password of the database manager page. Change it in your odoo.conf.
admin_passwd = change-me

; Listen on this machine only. Set explicitly: Odoo 19 warns when it is missing
; (its default changes from 0.0.0.0 to 127.0.0.1 in Odoo 20).
http_interface = 127.0.0.1
http_port = 8019

; No demo data in new databases (already the Odoo 19 default; tests never rely on demo data).
with_demo = False
